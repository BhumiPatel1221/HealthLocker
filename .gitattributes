# Normalize line endings to LF in the repository for all text files.
# Developers on Windows will still get CRLF in their working copy
# (controlled by core.autocrlf), but the repo always stores LF.

* text=auto eol=lf

# Explicitly LF
*.js        text eol=lf
*.ts        text eol=lf
*.tsx       text eol=lf
*.jsx       text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.css       text eol=lf
*.html      text eol=lf
*.mjs       text eol=lf
*.cjs       text eol=lf
*.env*      text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.sh        text eol=lf
.gitignore  text eol=lf

# Binary — no line-ending conversion
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.webp      binary
*.ico       binary
*.svg       binary
*.pdf       binary
*.zip       binary
*.ttf       binary
*.woff      binary
*.woff2     binary
*.eot       binary
